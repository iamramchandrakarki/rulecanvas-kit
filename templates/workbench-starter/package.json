{
  "name": "rulecanvas-workbench-starter",
  "version": "0.1.0",
  "private": true,
  "description": "RuleCanvasKit Skeleton Crew Starter Template: a CI/CD production release gate workbench built on the four RuleCanvasKit packages.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.nodenext.json"
  },
  "dependencies": {
    "@rulecanvas/core": "file:../rulecanvas-tarballs/rulecanvas-core-0.1.0.tgz",
    "@rulecanvas/ui": "file:../rulecanvas-tarballs/rulecanvas-ui-0.8.0.tgz",
    "@rulecanvas/workbench": "file:../rulecanvas-tarballs/rulecanvas-workbench-0.8.0.tgz",
    "@rulecanvas/workbench-react": "file:../rulecanvas-tarballs/rulecanvas-workbench-react-0.8.0.tgz",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
