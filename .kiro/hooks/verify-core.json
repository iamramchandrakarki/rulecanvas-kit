{
  "version": "v1",
  "hooks": [
    {
      "name": "verify-core-engine",
      "trigger": "PostFileSave",
      "matcher": "packages/rulecanvas-core/(src|tests)/.*\\.ts$",
      "action": {
        "type": "command",
        "command": "pnpm --filter @rulecanvas/core build && pnpm --filter @rulecanvas/core test"
      }
    }
  ]
}
